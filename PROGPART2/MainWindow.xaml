<Window x:Class="CybersecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant"
        Height="700"
        Width="1100">

    <Grid>

        <TabControl FontSize="14">

         
            <TabItem Header="Chatbot">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ChatListBox"
                             Grid.Row="0"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal">

                        <TextBox x:Name="MessageTextBox"
                                 Width="800"
                                 Height="35"
                                 Margin="0,10,10,0"/>
                        <Button x:Name="SendButton"
                                Content="Send"
                                Width="100"
                                Height="35"
                                Click="SendButton_Click"/>
                    </StackPanel>

                </Grid>

            </TabItem>

            
            <TabItem Header="Tasks">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <TextBox x:Name="TaskTitleTextBox"
                                 Width="200"
                                 Margin="5"/>

                        <TextBox x:Name="TaskDescriptionTextBox"
                                 Width="250"
                                 Margin="5"/>

                        <DatePicker x:Name="TaskDatePicker"
                                    Width="150"
                                    Margin="5"/>

                        <Button Content="Add Task"
                                Width="120"
                                Margin="5"
                                Click="AddTask_Click"/>

                    </StackPanel>

                    <DataGrid x:Name="TaskGrid"
                              Grid.Row="1"
                              Margin="0,10,0,0"
                              AutoGenerateColumns="True"/>

                </Grid>

            </TabItem>

            
            <TabItem Header="Quiz">

                <StackPanel Margin="20">

                    <TextBlock x:Name="QuestionText"
                               FontSize="20"
                               Margin="0,0,0,20"/>

                    <ListBox x:Name="QuizOptions"
                             Height="200"/>

                    <Button Content="Submit Answer"
                            Width="150"
                            Margin="0,20,0,0"
                            Click="SubmitAnswer_Click"/>

                    <TextBlock x:Name="QuizFeedback"
                               FontSize="16"
                               Margin="0,20,0,0"/>

                </StackPanel>

            </TabItem>

            
            <TabItem Header="Activity Log">

                <Grid Margin="10">

                    <ListBox x:Name="ActivityLogListBox"/>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</Window>